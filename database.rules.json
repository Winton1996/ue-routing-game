{
  "rules": {
    "sessions": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta').child('ownerUid').val() === auth.uid) || (data.child('meta').child('ownerUid').val() === auth.uid))",
        "meta": {
          "ownerUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "open": {
            ".validate": "newData.isBoolean()"
          },
          "revealed": {
            ".validate": "newData.isBoolean()"
          },
          "config": {
            "a1": {
              ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
            },
            "b1": {
              ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
            },
            "a2": {
              ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
            },
            "b2": {
              ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
            }
          }
        },
        "votes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('sessions').child($room).child('meta').child('open').val() === true",
            ".validate": "!newData.exists() || newData.val() === 1 || newData.val() === 2"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.val() === true"
          }
        }
      }
    }
  }
}
